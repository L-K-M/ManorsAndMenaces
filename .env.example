# Settings for the Docker Compose server. Copy this file to .env, next to
# docker-compose.yml, and edit it:
#
#   cp .env.example .env
#
# Compose reads .env on every `docker compose` command; restart with
# `docker compose up -d` after a change. Git ignores .env, so updates keep
# it. An empty or missing value means the default. "Hosting a server" in
# README.md walks through a setup.
#
# A value runs to the end of its line. Put it in single quotes if it
# contains a $ or a #, as passwords in SMTP_URL may.

# --- Address ----------------------------------------------------------------

# Where the server listens on this machine: a port, or address:port. Behind
# a reverse proxy on the same machine, use 127.0.0.1:8787 so that only the
# proxy reaches it. (Ports Docker publishes bypass firewalls such as ufw.)
PORT=8787

# Where players open the game, like https://play.example.org. The invites
# command prints whole links with it, and turn emails link there.
PUBLIC_URL=

# How many reverse proxies stand in front of the server: 1 behind Caddy or
# nginx, so that rate limits count each player separately instead of
# everyone behind the proxy together. Keep 0 when players reach PORT
# directly: they could then fake their address.
TRUST_PROXY=0

# --- Who can play -----------------------------------------------------------

# true opens the game only to people with a personal invite, you included.
# Make invites with:
#   docker compose exec manors node server.mjs invites create NAME
# Everyone invited can invite ten more from the online lobby. See
# docs/invites.md.
INVITE_ONLY=false

# --- Turn notifications (docs/notifications.md) -----------------------------

# Your contact for Web Push services: mailto:you@example.org or an https:
# address of yours. Empty means the project's repository.
VAPID_SUBJECT=

# Turn emails: set SMTP_URL, MAIL_FROM and PUBLIC_URL (above) to turn them
# on; leave SMTP_URL empty to keep them off.
#   SMTP_URL='smtps://user:password@smtp.example.org'       TLS, port 465
#   SMTP_URL='smtp://user:password@smtp.example.org:587'    STARTTLS
# Percent-encode reserved characters in the user and password (@ is %40,
# : is %3A).
SMTP_URL=
# The sender, like: Manors & Menaces <turns@example.org>
MAIL_FROM=

# Seconds between pings on the Android app's background connection, 60 to
# 3600. Each ping wakes the phone. Lower it only if a proxy closes idle
# WebSockets sooner (Cloudflare Free and Pro: after 100 s, so use 90).
BACKGROUND_PING_SECONDS=600

# --- Rarely changed ---------------------------------------------------------

# The web origin allowed to call the API. Keep * if anyone plays with the
# desktop or Android app: they call the API from origins of their own.
CORS_ORIGIN=*

# Pause between the computer players' moves, in milliseconds.
AI_DELAY_MS=700

# The image to run. `docker compose up -d --build` builds it from this
# checkout under this name. To run a published release without building,
# name one (the releases list the versions) and start it with
# `docker compose pull && docker compose up -d`.
IMAGE=ghcr.io/l-k-m/manorsandmenaces:latest
