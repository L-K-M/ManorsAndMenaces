{
  // Typechecks the TypeScript that no package tsconfig covers: tools,
  // cross-package tests, Playwright specs and the build and test configs.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "tools/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "apps/web/e2e/**/*.ts",
    "apps/web/playwright.config.ts",
    "apps/web/vite.config.ts"
  ]
}
