{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manors & Menaces",
  "version": "0.3.0",
  "identifier": "ch.lkmc.manorsmenaces",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @manors-menaces/web dev",
    "beforeBuildCommand": "pnpm --filter @manors-menaces/web build && node scripts/tauri-notices.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manors & Menaces",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "Unlicense",
    "licenseFile": "../LICENSE",
    "category": "StrategyGame",
    "shortDescription": "Plan your harvest, build your realm, redirect the trouble.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "files": {
        "Resources/Third-Party-Notices.txt": "licenses/Third-Party-Notices.txt",
        "Resources/Rust-Licenses.html": "licenses/Rust-Licenses.html",
        "Resources/LICENSE.txt": "../LICENSE"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/manors-menaces/copyright": "licenses/copyright",
          "/usr/share/doc/manors-menaces/Third-Party-Notices.txt": "licenses/Third-Party-Notices.txt",
          "/usr/share/doc/manors-menaces/Rust-Licenses.html": "licenses/Rust-Licenses.html"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/doc/manors-menaces/LICENSE": "../LICENSE",
          "/usr/share/doc/manors-menaces/Third-Party-Notices.txt": "licenses/Third-Party-Notices.txt",
          "/usr/share/doc/manors-menaces/Rust-Licenses.html": "licenses/Rust-Licenses.html"
        }
      },
      "appimage": {
        "files": {
          "/usr/share/doc/manors-menaces/copyright": "licenses/copyright",
          "/usr/share/doc/manors-menaces/Third-Party-Notices.txt": "licenses/Third-Party-Notices.txt",
          "/usr/share/doc/manors-menaces/Rust-Licenses.html": "licenses/Rust-Licenses.html"
        }
      }
    }
  }
}
