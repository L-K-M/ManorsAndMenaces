{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manors & Menaces",
  "version": "0.1.0",
  "identifier": "ch.lkm.manorsmenaces",
  "build": {
    "frontendDist": "../apps/web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @manors-menaces/web dev",
    "beforeBuildCommand": "pnpm --filter @manors-menaces/web build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Manors & Menaces",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' http: https: ws: wss: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "StrategyGame",
    "shortDescription": "Plan your harvest, build your realm, redirect the trouble.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
